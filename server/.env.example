# Copy to .env and fill in. Never commit .env — it is git-ignored.

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local (docker compose up -d):
#   mongodb://127.0.0.1:27017/university-exam-system?directConnection=true
# Atlas → Database → Connect → Drivers. Replace <password> with the database user's
# password, and put the database name before the '?'.
MONGODB_URI=mongodb://127.0.0.1:27017/university-exam-system?directConnection=true

# Exact origins allowed to call this API, comma-separated. No trailing slash.
# Local development uses the Vite dev server; add the Vercel URL when deployed.
CORS_ORIGINS=http://localhost:5173

# Signing key for access tokens. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a DIFFERENT value in production from the one used locally.
JWT_ACCESS_SECRET=

# Access tokens are short-lived; the refresh cookie renews them silently.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Shared password for the seeded demo accounts listed on the login page.
# These accounts are public by design so a visitor can explore without credentials.
SEED_DEMO_PASSWORD=Demo@12345
