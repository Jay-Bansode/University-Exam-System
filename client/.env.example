# Copy to .env.local for local development. Vite only exposes variables prefixed VITE_.
#
# Anything here is compiled into the JavaScript bundle and is therefore public.
# Never put a secret in this file.

# Base URL of the API, with no trailing slash.
# Local: http://localhost:5000
# Production: the Render service URL, e.g. https://ues-api.onrender.com
VITE_API_BASE_URL=http://localhost:5000
