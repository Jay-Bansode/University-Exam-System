{
  "name": "university-exam-system",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant examination management system for an affiliated university and its colleges",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
